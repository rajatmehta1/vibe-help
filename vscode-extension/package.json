{
  "name": "forgeline",
  "displayName": "ForgeLine",
  "description": "AI-Generated Code Governance",
  "version": "0.0.1",
  "publisher": "forgeline",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ForgeLine.scanFile",
        "title": "ForgeLine: Scan Current File"
      },
      {
        "command": "ForgeLine.scanWorkspace",
        "title": "ForgeLine: Scan Workspace"
      },
      {
        "command": "ForgeLine.indexWorkspace",
        "title": "ForgeLine: Index Workspace"
      },
      {
        "command": "ForgeLine.injectContext",
        "title": "ForgeLine: Inject Context"
      },
      {
        "command": "ForgeLine.markAsAIGenerated",
        "title": "ForgeLine: Mark as AI Generated"
      },
      {
        "command": "ForgeLine.showSummary",
        "title": "ForgeLine: Show Summary Panel",
        "icon": "$(output)"
      },
      {
        "command": "ForgeLine.scanSelection",
        "title": "ForgeLine: Scan Selection"
      },
      {
        "command": "ForgeLine.refreshTree",
        "title": "ForgeLine: Refresh Violations",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forgeline",
          "title": "ForgeLine",
          "icon": "$(shield)"
        }
      ]
    },
    "views": {
      "forgeline": [
        {
          "id": "forgelineViolations",
          "name": "Violations",
          "contextualTitle": "ForgeLine"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "ForgeLine.refreshTree",
          "when": "view == forgelineViolations",
          "group": "navigation"
        },
        {
          "command": "ForgeLine.showSummary",
          "when": "view == forgelineViolations",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "ForgeLine.scanSelection",
          "when": "editorHasSelection",
          "group": "ForgeLine@1"
        },
        {
          "command": "ForgeLine.markAsAIGenerated",
          "when": "editorHasSelection",
          "group": "ForgeLine@2"
        }
      ]
    },
    "configuration": {
      "title": "ForgeLine",
      "properties": {
        "forgeline.serverUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "ForgeLine server URL"
        },
        "forgeline.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for authentication"
        },
        "forgeline.projectId": {
          "type": "string",
          "default": "",
          "description": "Current project ID"
        },
        "forgeline.autoScan": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic scanning"
        },
        "forgeline.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Scan files on save"
        },
        "forgeline.severityThreshold": {
          "type": "string",
          "default": "warning",
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "description": "Minimum severity threshold for reporting"
        }
      }
    }
  },
  "scripts": {
    "compile": "npm run check-types && node esbuild.js",
    "check-types": "tsc --noEmit",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "vscode:prepublish": "npm run package",
    "package": "npm run check-types && node esbuild.js --production"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.24.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.3.0"
  }
}
